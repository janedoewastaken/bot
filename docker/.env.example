# Copy to .env and set your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Where SQLite databases are stored on the host (created automatically).
# WOS_DB_PATH=./data/db
# WOS_DB_PATH=/opt/docker/wos/db

